# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets
LocationIQ.txt

# calibration debug rasters (régénérés par scripts/calibrate_cmr_map.py)
scripts/*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs locales
/docs/

# Cursor / agents IA (hors AGENTS.md / CLAUDE.md du template Next)
.cursor/
.cursorrules
.cursorignore
/project_context.md

# pnpm local — le dépôt reste npm (package-lock.json)
pnpm-lock.yaml
pnpm-workspace.yaml
.playwright-mcp/
